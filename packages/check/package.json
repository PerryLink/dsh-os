{
  "name": "dsh-canary",
  "version": "0.4.0",
  "description": "Paired-environment regression canary for DeepSeek Harness upgrades, model changes and plugin updates.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "dsh-check": "bin/dsh-check.js"
  },
  "exports": {
    ".": "./index.js",
    "./runner": "./lib/runner.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-os",
    "check",
    "canary",
    "regression",
    "eval"
  ],
  "license": "MIT",
  "author": "PerryLink contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-os.git",
    "directory": "packages/check"
  },
  "homepage": "https://github.com/PerryLink/dsh-os/tree/main/packages/check#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-os/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.9.0",
    "dsh": ">=0.2.2-alpha.2 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "os": {
      "service": "check",
      "provides": [
        "check"
      ],
      "capabilities": [
        "spawn"
      ],
      "tools": [
        "check_compare",
        "check_run"
      ],
      "ui": null,
      "stability": "experimental",
      "since": "0.1.0"
    }
  },
  "scripts": {
    "test": "node --test"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}

{
  "name": "dsh-price",
  "version": "0.1.0",
  "description": "Optional cost adapter for dsh-cost-meter: meter passthrough plus a local USD budget ledger and pre-flight gate for DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-os",
    "cost",
    "budget",
    "usage",
    "adapter"
  ],
  "license": "MIT",
  "author": "PerryLink contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-os.git",
    "directory": "packages/cost"
  },
  "homepage": "https://github.com/PerryLink/dsh-os/tree/main/packages/cost#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-os/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.9.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "os": {
      "service": "cost",
      "provides": [
        "cost"
      ],
      "capabilities": [],
      "tools": [
        "cost_summary",
        "cost_budget_set",
        "cost_budget_check"
      ],
      "ui": null,
      "stability": "experimental",
      "since": "0.1.0"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}

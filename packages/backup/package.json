{
  "name": "dsh-timecapsule",
  "version": "0.2.0",
  "description": "Read-only, allowlisted filesystem snapshot manifests and restore plans for DeepSeek Harness: metadata inventory with sensitive-path exclusions and hard caps, no copying and no deleting.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-os",
    "backup",
    "snapshot",
    "manifest",
    "restore"
  ],
  "license": "MIT",
  "author": "PerryLink contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-os.git",
    "directory": "packages/backup"
  },
  "homepage": "https://github.com/PerryLink/dsh-os/tree/main/packages/backup#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-os/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.9.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "os": {
      "service": "backup",
      "provides": [
        "backup"
      ],
      "capabilities": [
        "fs.read"
      ],
      "tools": [
        "backup_snapshot",
        "backup_diff",
        "backup_plan_restore"
      ],
      "ui": null,
      "stability": "experimental",
      "since": "0.1.0"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test"
  }
}

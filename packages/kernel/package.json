{
  "name": "@perrylink/dsh-os-kernel",
  "version": "0.2.0",
  "description": "Thin capability kernel for dsh-os: descriptor protocol, registry, legacy tool bridge and six os_* agent verbs.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./descriptor": "./lib/descriptor.js",
    "./registry": "./lib/registry.js",
    "./from-tool": "./lib/from-tool.js",
    "./gateway": "./lib/gateway.js",
    "./package.json": "./package.json",
    "./service": "./lib/service.js",
    "./envelope": "./lib/envelope.js"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-os",
    "capability",
    "kernel",
    "registry"
  ],
  "license": "MIT",
  "author": "PerryLink contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-os.git",
    "directory": "packages/kernel"
  },
  "homepage": "https://github.com/PerryLink/dsh-os/tree/main/packages/kernel#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-os/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.9.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "os": {
      "service": "kernel",
      "provides": [
        "kernel"
      ],
      "requires": [],
      "capabilities": [],
      "tools": [
        "os_find",
        "os_do",
        "os_request",
        "os_observe",
        "os_help",
        "os_status"
      ],
      "ui": null,
      "stability": "experimental",
      "since": "0.1.0"
    }
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test"
  }
}

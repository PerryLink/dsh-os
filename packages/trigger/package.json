{
  "name": "dsh-trigger",
  "version": "0.4.0",
  "description": "Event-to-action trigger fabric for DeepSeek Harness: condition DSL, cooldown, run ledger and real agent / fs / webhook event sources.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-os",
    "trigger",
    "webhook",
    "filesystem"
  ],
  "license": "MIT",
  "author": "PerryLink contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-os.git",
    "directory": "packages/trigger"
  },
  "homepage": "https://github.com/PerryLink/dsh-os/tree/main/packages/trigger#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-os/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.9.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "os": {
      "service": "triggers",
      "provides": [
        "triggers"
      ],
      "capabilities": [
        "fs.read",
        "net"
      ],
      "tools": [
        "trigger_register",
        "trigger_list",
        "trigger_fire",
        "trigger_runs",
        "trigger_sources",
        "trigger_source_start",
        "trigger_source_stop"
      ],
      "ui": null,
      "stability": "experimental",
      "since": "0.1.0"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "node --test"
  }
}
